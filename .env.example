# Sao chép thành .env rồi điền giá trị THẬT (tệp .env đã nằm trong .gitignore)
# --- SSI FastConnect Data (lấy tại iBoard > Dịch vụ API; KHÔNG cần Private Key) ---
SSI_CONSUMER_ID=your_consumer_id_here
SSI_CONSUMER_SECRET=your_consumer_secret_here
# --- VPBankS NEO API (luồng WebSocket song song) ---
NEO_USERNAME=your_neo_username
NEO_PASSWORD=your_neo_password
# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_IDS=111111111,222222222
# --- Chế độ chạy ---
# true  = dùng dữ liệu MẪU tổng hợp (không cần khóa, có nhãn "dữ liệu mẫu" trên mọi kênh)
# false = dùng dữ liệu thật tải từ SSI/NEO
DEMO_DATA=true
LOG_LEVEL=INFO
