# Sao chép thành .env rồi điền giá trị THẬT (tệp .env đã nằm trong .gitignore)
# SSI FastConnect V3: tạo API Key và API Secret tại Developer Portal (developers.ssi.com.vn).
# Chỉ cấp quyền Market Data / stream DATA cần dùng. Không cần OTP / Private Key (hệ thống chỉ đọc dữ liệu, không đặt lệnh).
SSI_API_KEY=
SSI_API_SECRET=
SSI_BASE_URL=https://api.ssi.com.vn
SSI_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_IDS=111111111,222222222
LOG_LEVEL=INFO
